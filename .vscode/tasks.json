{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Sierra Chart Study (Release)",
      "type": "shell",
      "command": "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvarsall.bat\"",
      "args": [
        "amd64",
        "&&",
        "cl",
        "/Zc:wchar_t",
        "/GS",
        "/GL",
        "/W3",
        "/O2",
        "/Zc:inline",
        "/D",
        "NDEBUG",
        "/D",
        "_WINDOWS",
        "/D",
        "_USRDLL",
        "/D",
        "_WINDLL",
        "/Oy",
        "/Gd",
        "/Gy",
        "/Oi",
        "/GR-",
        "/GF",
        "/Ot",
        "/fp:precise",
        "/MT",
        "/std:c++17",
        "/LD",
        "/EHa",
        "/WX-",
        "/nologo",
        "${file}",
        "/I${fileDirname}",
        "/IC:\\SierraChart\\ACS_Source",
        "/FoD:\\dev\\SierraChart\\Studies\\BuildFiles\\",
        "/link",
        "Gdi32.lib",
        "User32.lib",
        "/DLL",
        "/DYNAMICBASE",
        "/INCREMENTAL:NO",
        "/OPT:REF",
        "/OPT:ICF",
        "/MACHINE:X64",
        "/OUT:C:\\SierraChart\\Data\\${fileBasenameNoExtension}.dll",
        "/IMPLIB:D:\\dev\\SierraChart\\Studies\\BuildFiles\\${fileBasenameNoExtension}.lib"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Clean Sierra Chart Study BuildFiles",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-Command",
        "Remove-Item 'D:\\dev\\SierraChart\\Studies\\BuildFiles\\*.obj','D:\\dev\\SierraChart\\Studies\\BuildFiles\\*.lib','D:\\dev\\SierraChart\\Studies\\BuildFiles\\*.exp' -ErrorAction SilentlyContinue"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Sierra Chart Study (Release) + Clean",
      "dependsOn": [
        "Build Sierra Chart Study (Release)",
        "Clean Sierra Chart Study BuildFiles"
      ],
     "dependsOrder": "sequence",
        "group": {
           "kind": "build",
           "isDefault": true
        }
    }
  ]
}